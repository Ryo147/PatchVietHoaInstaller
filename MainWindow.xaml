<Window x:Class="VietHoaInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phần mềm cài đặt Việt hóa"
        Height="720" Width="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgDarkBrush}"
        FontFamily="Arial">
    <Border BorderBrush="#3A3F4E" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#161A24" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="Assets/Dich2000sICON.ico" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Phần mềm cài đặt Việt hóa"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12.5" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Content="—" Style="{StaticResource TitleBarButtonStyle}"
                            Click="BtnMinimize_Click"/>
                    <Button x:Name="BtnClose" Content="✕" Style="{StaticResource CloseButtonStyle}"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource NavRailBgBrush}"
                        BorderBrush="{StaticResource NavBorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                            <RadioButton x:Name="NavHome" Style="{StaticResource NavButtonStyle}"
                                         GroupName="Nav" IsChecked="True" Tag="Home" Checked="NavButton_Checked">
                                <StackPanel>
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Trang chủ" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavLibrary" Style="{StaticResource NavButtonStyle}"
                                         GroupName="Nav" Tag="Library" Checked="NavButton_Checked">
                                <StackPanel>
                                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Dự án" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavUpdates" Style="{StaticResource NavButtonStyle}"
                                         GroupName="Nav" Tag="Updates" Checked="NavButton_Checked">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Cập nhật" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Ellipse x:Name="NavUpdateDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                                             Stroke="{StaticResource NavRailBgBrush}" StrokeThickness="1.5"
                                             HorizontalAlignment="Center" VerticalAlignment="Top"
                                             Margin="20,-2,0,0" Visibility="Collapsed"/>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavButtonStyle}"
                                         GroupName="Nav" Tag="Settings" Checked="NavButton_Checked">
                                <StackPanel>
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Cài đặt" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <RadioButton x:Name="NavAbout" DockPanel.Dock="Bottom" Style="{StaticResource NavButtonStyle}"
                                     GroupName="Nav" Tag="About" Checked="NavButton_Checked" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="Giới thiệu" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </DockPanel>
                </Border>

                <ContentControl Grid.Column="1" x:Name="MainContent" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="MainContentTransform" Y="0"/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>

            <Border Grid.Row="2" Background="#161A24" BorderBrush="#2C3244" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Run Foreground="#FF8B90A3" FontSize="11.5" Text="Discord: "/>
                        <Run Text=" "/>
                        <Hyperlink NavigateUri="https://discord.gg/snadgBATJm" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Foreground="#FFF2F3F7" FontSize="11.5" Text="Dịch 2000s"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><Run Foreground="#FF8B90A3" FontSize="11.5" Text="Dev."/><Run Text=" "/><Run Foreground="#FFF2F3F7" FontSize="11.5" Text="Claude x Nhựa Inox"/><Run Text=" "/><Run x:Name="RunAppVersion" Foreground="#FF8B90A3" FontSize="11.5" Text=""/></TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
