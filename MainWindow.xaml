<Window x:Class="VietHoaInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phần mềm cài đặt Việt hóa"
        Height="700" Width="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgDarkBrush}"
        FontFamily="Arial">

    <Border BorderBrush="#3A3F4E" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <!-- Title bar -->
                <RowDefinition Height="Auto"/>
                <!-- Banner cập nhật (ẩn mặc định) -->
                <RowDefinition Height="*"/>
                <!-- Nội dung -->
                <RowDefinition Height="34"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ============ TITLE BAR ============ -->
            <Grid Grid.Row="0" Background="#161A24" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="Assets/Dich2000sICON.ico" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Phần mềm cài đặt Việt hóa"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12.5" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Content="—" Style="{StaticResource TitleBarButtonStyle}"
                            Click="BtnMinimize_Click"/>
                    <Button x:Name="BtnClose" Content="✕" Style="{StaticResource CloseButtonStyle}"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- ============ BANNER CẬP NHẬT ỨNG DỤNG ============ -->
            <Border Grid.Row="1" x:Name="PanelUpdateBanner" Visibility="Collapsed"
                    Background="#2A2118" BorderBrush="#5A4A28" BorderThickness="0,0,0,1" Padding="10,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="RunUpdateMessage" Foreground="#FFD98A" FontSize="12" VerticalAlignment="Center"
                               Text="🔔 Đã có bản cập nhật mới!"/>
                    <Button x:Name="BtnUpdateNow" Content="Cập nhật ngay" Margin="10,0,0,0"
                            Style="{StaticResource BrowseButtonStyle}" Click="BtnUpdateNow_Click"/>
                    <TextBlock Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center">
                        <Hyperlink x:Name="LinkUpdateDownload" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Foreground="#FF8B90A3" Text="Xem chi tiết"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ============ NỘI DUNG CHÍNH ============ -->
            <Grid Grid.Row="2" Margin="24,20,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="130"/>
                    <!-- Banner -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Chọn game -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Trạng thái -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Label thư mục -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="34"/>
                    <!-- Ô đường dẫn -->
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="42"/>
                    <!-- Nút hành động -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Progress -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- ===== BANNER / LOGO GAME ===== -->
                <Border Grid.Row="0" CornerRadius="1" BorderBrush="#3A3F4E" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush x:Name="BannerImageBrush" ImageSource="/Assets/PlagueIncVH.jpg" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <!-- ===== CHỌN GAME ===== -->
                <ComboBox Grid.Row="2" x:Name="CmbGame" Height="34"
                  Style="{StaticResource DarkComboBoxStyle}"
                  DisplayMemberPath="Name"
                  SelectionChanged="CmbGame_SelectionChanged" Background="Black" Foreground="White"/>

                <!-- ===== TRẠNG THÁI ===== -->
                <StackPanel Grid.Row="4" Orientation="Horizontal">
                    <TextBlock Text="Trạng thái:" Foreground="{StaticResource TextMutedBrush}" FontSize="13.5" VerticalAlignment="Center"/>
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource WarnBrush}"
                             Margin="10,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="Chưa cài đặt Việt hóa"
                               Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"
                               FontSize="13.5" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ===== LABEL THƯ MỤC GAME ===== -->
                <TextBlock Grid.Row="6" Text="Thư mục game:"
                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="13.5" FontFamily="Arial"/>

                <!-- ===== Ô ĐƯỜNG DẪN + NÚT CHỌN ===== -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtGamePath" Grid.Column="0" Style="{StaticResource PathTextBoxStyle}"
                             Text="Nhấp Chọn... để cài đặt thư mục cần cài đặt Việt hóa"
                             TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" TextChanged="TxtGamePath_TextChanged" Foreground="White"/>
                    <Button x:Name="BtnAutoDetect" Grid.Column="2" Content="Tự động tìm"
                            Style="{StaticResource BrowseButtonStyle}" Click="BtnAutoDetect_Click"/>
                    <Button x:Name="BtnBrowse" Grid.Column="4" Content="Chọn..."
                            Style="{StaticResource BrowseButtonStyle}" Click="BtnBrowse_Click"/>
                </Grid>

                <!-- ===== NÚT CÀI ĐẶT / GỠ ===== -->
                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnInstall" Grid.Column="0" Content="CÀI ĐẶT PATCH"
                            Style="{StaticResource PrimaryButtonStyle}" Click="BtnInstall_Click"/>
                    <Button x:Name="BtnUninstall" Grid.Column="2" Content="Gỡ Việt Hóa"
                            Style="{StaticResource SecondaryButtonStyle}" Click="BtnUninstall_Click"
                            IsEnabled="False"/>
                </Grid>
                <!-- ===== TIẾN TRÌNH CÀI ĐẶT ===== -->
                <StackPanel Grid.Row="12" x:Name="PanelProgress" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Đang cài đặt:" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ProgressBar x:Name="ProgressInstall" Grid.Column="1" Style="{StaticResource InstallProgressBarStyle}"
                                     Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPercent" Grid.Column="2" Text="0%"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"
                                   VerticalAlignment="Center" Margin="10,0,0,0" Width="36"/>
                    </Grid>
                    <TextBlock x:Name="TxtProgressDetail" Text=""
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

            </Grid>

            <!-- ============ FOOTER ============ -->
            <Border Grid.Row="3" Background="#161A24" BorderBrush="#2C3244" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Run Foreground="#FF8B90A3" FontSize="11.5" Text="Discord: "/>
                        <Run Text=" "/>
                        <Hyperlink NavigateUri="https://discord.gg/snadgBATJm" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Foreground="#FFF2F3F7" FontSize="11.5" Text="Dịch 2000s"/>
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><Run Foreground="#FF8B90A3" FontSize="11.5" Text="Dev."/><Run Text=" "/><Run Foreground="#FFF2F3F7" FontSize="11.5" Text="Claude x Nhựa Inox"/><Run Text="   "/><Run x:Name="RunAppVersion" Foreground="#FF8B90A3" FontSize="11.5" Text=""/></TextBlock>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>