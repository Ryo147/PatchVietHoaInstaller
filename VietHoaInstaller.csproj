<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<AssemblyName>PatchVietHoaInstaller</AssemblyName>
		<RootNamespace>PatchVietHoaInstaller</RootNamespace>

		<!-- Nguồn duy nhất khai báo version của app. Mỗi lần release, chỉ cần sửa số này ở đây -->
		<Version>3.1.0</Version>

		<!-- Prevent duplicate assembly attributes -->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<Company>PatchVietHoaInstaller</Company>
		<Product>PatchVietHoaInstaller</Product>
		<Title>PatchVietHoaInstaller</Title>

		<!-- Đóng gói tối ưu: 1 file .exe duy nhất, không cần cài .NET Runtime -->
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>true</PublishReadyToRun>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<DebugType>none</DebugType>
		<SatelliteResourceLanguages>vi</SatelliteResourceLanguages>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<ApplicationIcon>Assets\Dich2000sICON.ico</ApplicationIcon>

		<!-- Giảm dung lượng: tắt các tính năng chẩn đoán/telemetry hiếm khi cần cho 1 tool cài đặt nhỏ -->
		<EventSourceSupport>false</EventSourceSupport>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
		<UseRidGraph>false</UseRidGraph>

		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\PlagueIncVH.jpg" />
		<None Remove="Assets\RE2_DX11.png" />
		<None Remove="Assets\Dich2000sICON.ico" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\PlagueIncVH.jpg" />
		<Resource Include="Assets\RE2_DX11.png" />
		<Resource Include="Assets\Dich2000sICON.ico" />
	</ItemGroup>

</Project>