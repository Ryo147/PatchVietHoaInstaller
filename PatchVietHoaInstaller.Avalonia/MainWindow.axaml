<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VietHoaInstaller.MainWindow"
        Title="Phần mềm cài đặt Việt hóa"
        Width="720" Height="720"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        Background="Transparent">

	<!-- Lớp nền trong suốt để chứa bóng đổ -->
	<Border Margin="10" Background="{StaticResource BgDarkBrush}" CornerRadius="10"
	        BoxShadow="0 0 25 0 #99000000">
		<Border BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
			<Grid RowDefinitions="44,*">

				<!-- ============ TITLE BAR + ĐIỀU HƯỚNG ============ -->
				<Grid Grid.Row="0" Background="#161A24" ColumnDefinitions="Auto,*,Auto"
				      PointerPressed="TitleBar_PointerPressed">

					<Image Grid.Column="0" Source="avares://VietHoaInstaller.Avalonia/Assets/Dich2000sICON.ico"
					       Width="16" Height="16" VerticalAlignment="Center" Margin="14,0,14,0"/>

					<Grid Grid.Column="1" HorizontalAlignment="Center">
						<Border x:Name="NavIndicator" Width="40" Height="3" CornerRadius="2"
						        HorizontalAlignment="Left" VerticalAlignment="Bottom"
						        Background="{StaticResource AccentBrush}">
							<Border.RenderTransform>
								<TranslateTransform X="0">
									<TranslateTransform.Transitions>
										<Transitions>
											<DoubleTransition Property="X" Duration="0:0:0.24"/>
										</Transitions>
									</TranslateTransform.Transitions>
								</TranslateTransform>
							</Border.RenderTransform>
						</Border>

						<StackPanel Orientation="Horizontal">
							<RadioButton x:Name="NavHome" Classes="TopNavTab" GroupName="Nav" IsChecked="True" Tag="Home" Checked="NavButton_Checked">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="🏠" FontSize="13" VerticalAlignment="Center"/>
									<TextBlock Text="Trang chủ" FontSize="11.5" VerticalAlignment="Center"/>
								</StackPanel>
							</RadioButton>
							<RadioButton x:Name="NavLibrary" Classes="TopNavTab" GroupName="Nav" Tag="Library" Checked="NavButton_Checked">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="📁" FontSize="13" VerticalAlignment="Center"/>
									<TextBlock Text="Dự án" FontSize="11.5" VerticalAlignment="Center"/>
								</StackPanel>
							</RadioButton>
							<RadioButton x:Name="NavUpdates" Classes="TopNavTab" GroupName="Nav" Tag="Updates" Checked="NavButton_Checked">
								<Grid>
									<StackPanel Orientation="Horizontal" Spacing="6">
										<TextBlock Text="🔄" FontSize="13" VerticalAlignment="Center"/>
										<TextBlock Text="Cập nhật" FontSize="11.5" VerticalAlignment="Center"/>
									</StackPanel>
									<Ellipse x:Name="NavUpdateDot" Width="6" Height="6" Fill="{StaticResource AccentBrush}"
									         Stroke="#161A24" StrokeThickness="1.5" HorizontalAlignment="Left"
									         VerticalAlignment="Top" Margin="9,7,0,0" IsVisible="False"/>
								</Grid>
							</RadioButton>
							<RadioButton x:Name="NavSettings" Classes="TopNavTab" GroupName="Nav" Tag="Settings" Checked="NavButton_Checked">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="⚙" FontSize="13" VerticalAlignment="Center"/>
									<TextBlock Text="Cài đặt" FontSize="11.5" VerticalAlignment="Center"/>
								</StackPanel>
							</RadioButton>
							<RadioButton x:Name="NavAbout" Classes="TopNavTab" GroupName="Nav" Tag="About" Checked="NavButton_Checked">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="ℹ" FontSize="13" VerticalAlignment="Center"/>
									<TextBlock Text="Giới thiệu" FontSize="11.5" VerticalAlignment="Center"/>
								</StackPanel>
							</RadioButton>
						</StackPanel>
					</Grid>

					<StackPanel Grid.Column="2" Orientation="Horizontal">
						<Button x:Name="BtnMinimize" Content="—" Classes="TitleBarButton" Click="BtnMinimize_Click"/>
						<Button x:Name="BtnClose" Content="✕" Classes="CloseButton" Click="BtnClose_Click"/>
					</StackPanel>
				</Grid>

				<!-- ============ NỘI DUNG TRANG ============ -->
				<ContentControl Grid.Row="1" x:Name="MainContent" Focusable="False" Opacity="1">
					<ContentControl.RenderTransform>
						<TranslateTransform Y="0">
							<TranslateTransform.Transitions>
								<Transitions>
									<DoubleTransition Property="Y" Duration="0:0:0.22"/>
								</Transitions>
							</TranslateTransform.Transitions>
						</TranslateTransform>
					</ContentControl.RenderTransform>
					<ContentControl.Transitions>
						<Transitions>
							<DoubleTransition Property="Opacity" Duration="0:0:0.22"/>
						</Transitions>
					</ContentControl.Transitions>
				</ContentControl>

				<!-- TOAST -->
				<Border x:Name="ToastHost" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center"
				        VerticalAlignment="Bottom" Margin="0,0,0,24" Background="#2A2F42" BorderBrush="#3A3F4E"
				        BorderThickness="1" CornerRadius="8" Padding="16,10" Opacity="0" IsHitTestVisible="False">
					<Border.Transitions>
						<Transitions>
							<DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
						</Transitions>
					</Border.Transitions>
					<TextBlock x:Name="TxtToast" Text="" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"/>
				</Border>
			</Grid>
		</Border>
	</Border>
</Window>
