<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- Không còn "-windows": đây là điểm mấu chốt để chạy được trên Linux/macOS -->
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<AssemblyName>PatchVietHoaInstaller</AssemblyName>
		<RootNamespace>PatchVietHoaInstaller</RootNamespace>

		<!-- Nguồn duy nhất khai báo version của app. Mỗi lần release, chỉ cần sửa số này ở đây -->
		<Version>4.3.0</Version>

		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<Company>PatchVietHoaInstaller</Company>
		<Product>PatchVietHoaInstaller</Product>
		<Title>PatchVietHoaInstaller</Title>

		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<!--
		Build cho Windows (giữ hành vi self-contained/single-file như bản WPF cũ):
		dotnet publish -r win-x64 -p:PublishSingleFile=true -p:SelfContained=true

		Build cho Linux:
		dotnet publish -r linux-x64 -p:PublishSingleFile=true -p:SelfContained=true

		RuntimeIdentifier để trống ở đây, chỉ định lúc publish qua -r để 1 project build được cả 2 OS.
	-->

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.2.3" />
		<PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
		<PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
		<PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Assets\**" />
		<AvaloniaResource Include="Assets\**" Exclude="Assets\RawSource\**" />
	</ItemGroup>

	<!--
		Tự động tối ưu banner: ảnh gốc (4K, tái chế từ truyền thông/marketing) thả vào Assets/RawSource/,
		Target này tự resize + nén JPEG rồi xuất ra Assets/ TRƯỚC khi Avalonia gom resource vào assembly.
		Không cần chạy tay tool riêng mỗi lần thêm banner mới — build bình thường là đủ.
		Chi tiết xử lý ảnh: xem tools/OptimizeBanner/Program.cs.

		Có Condition chặn Exec khi Assets/RawSource/ không có ảnh mới -> build bình thường (không thêm
		banner) không hề chậm đi.
	-->
	<Target Name="OptimizeRawBanners" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<RawBannerSource Include="Assets\RawSource\*.png;Assets\RawSource\*.jpg;Assets\RawSource\*.jpeg;Assets\RawSource\*.webp;Assets\RawSource\*.bmp" />
		</ItemGroup>

		<Exec Condition="'@(RawBannerSource)' != ''"
		      Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\tools\OptimizeBanner&quot; -c Release -- --all &quot;$(MSBuildThisFileDirectory)Assets\RawSource&quot; &quot;$(MSBuildThisFileDirectory)Assets&quot;"
		      ContinueOnError="WarnAndContinue" />

		<!-- Đăng ký ngay các .jpg vừa xuất (hoặc đã có sẵn từ lần build trước) làm AvaloniaResource
		     TRONG chính lần build này -> không cần build 2 lần mới nhận diện được banner mới. -->
		<ItemGroup>
			<GeneratedBannerJpg Include="$(MSBuildThisFileDirectory)Assets\%(RawBannerSource.Filename).jpg" Condition="Exists('$(MSBuildThisFileDirectory)Assets\%(RawBannerSource.Filename).jpg')" />
		</ItemGroup>
		<ItemGroup>
			<AvaloniaResource Include="@(GeneratedBannerJpg)" />
			<None Remove="@(GeneratedBannerJpg)" />
		</ItemGroup>
	</Target>

</Project>