<UserControl x:Class="VietHoaInstaller.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Arial">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <!-- header: Cập nhật -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
            <!-- row: Auto update -->
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <!-- header: Cài đặt & gỡ -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
            <!-- row: Confirm uninstall -->
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
            <!-- row: Auto open folder -->
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <!-- header: Cửa sổ -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
            <!-- row: Always on top -->
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <!-- header: Dữ liệu -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
            <!-- row: remembered folder -->
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
            <!-- row: clear log -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Cài đặt phần mềm"
                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>

        <!-- ===== NHÓM: CẬP NHẬT ===== -->
        <TextBlock Grid.Row="2" Text="CẬP NHẬT" Style="{StaticResource SectionHeaderStyle}"/>
        <Border Grid.Row="4" Height="1" Background="{StaticResource DividerBrush}"/>

        <Grid Grid.Row="5" Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Tự động kiểm tra cập nhật" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                <TextBlock Text="Kiểm tra bản mới mỗi khi mở ứng dụng" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="ChkAutoUpdate" Style="{StaticResource ToggleSwitchStyle}"
                      VerticalAlignment="Center" Checked="ChkAutoUpdate_Changed" Unchecked="ChkAutoUpdate_Changed"/>
        </Grid>

        <!-- ===== NHÓM: CÀI ĐẶT & GỠ VIỆT HÓA ===== -->
        <TextBlock Grid.Row="7" Text="CÀI ĐẶT &amp; GỠ VIỆT HÓA" Style="{StaticResource SectionHeaderStyle}"/>
        <Border Grid.Row="9" Height="1" Background="{StaticResource DividerBrush}"/>

        <Grid Grid.Row="10" Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Xác nhận trước khi Gỡ Việt hóa" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                <TextBlock Text="Hiện hộp thoại hỏi lại trước khi gỡ" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="ChkConfirmUninstall" Style="{StaticResource ToggleSwitchStyle}"
                      VerticalAlignment="Center" Checked="ChkConfirmUninstall_Changed" Unchecked="ChkConfirmUninstall_Changed"/>
        </Grid>

        <Border Grid.Row="11" Height="1" Background="{StaticResource DividerBrush}"/>

        <Grid Grid.Row="12" Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Tự động mở thư mục game sau khi cài xong" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                <TextBlock Text="Mở File Explorer ngay khi cài đặt hoàn tất" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="ChkAutoOpenFolder" Style="{StaticResource ToggleSwitchStyle}"
                      VerticalAlignment="Center" Checked="ChkAutoOpenFolder_Changed" Unchecked="ChkAutoOpenFolder_Changed"/>
        </Grid>

        <!-- ===== NHÓM: CỬA SỔ ỨNG DỤNG ===== -->
        <TextBlock Grid.Row="14" Text="CỬA SỔ ỨNG DỤNG" Style="{StaticResource SectionHeaderStyle}"/>
        <Border Grid.Row="16" Height="1" Background="{StaticResource DividerBrush}"/>

        <Grid Grid.Row="17" Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Luôn hiển thị cửa sổ trên cùng" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                <TextBlock Text="Giữ app nổi trên các cửa sổ khác" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="ChkAlwaysOnTop" Style="{StaticResource ToggleSwitchStyle}"
                      VerticalAlignment="Center" Checked="ChkAlwaysOnTop_Changed" Unchecked="ChkAlwaysOnTop_Changed"/>
        </Grid>

        <!-- ===== NHÓM: DỮ LIỆU ===== -->
        <TextBlock Grid.Row="19" Text="DỮ LIỆU" Style="{StaticResource SectionHeaderStyle}"/>
        <Border Grid.Row="21" Height="1" Background="{StaticResource DividerBrush}"/>

        <Grid Grid.Row="22" Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Thư mục game đã ghi nhớ" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                <TextBlock x:Name="TxtRememberedFolder" Text="(chưa có)" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Xóa" Style="{StaticResource FlatCardButtonStyle}"
                    VerticalAlignment="Center" Click="BtnClearFolder_Click"/>
        </Grid>

        <Border Grid.Row="23" Height="1" Background="{StaticResource DividerBrush}"/>

        <Grid Grid.Row="24" Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Nhật ký hoạt động ở Trang chủ" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                <TextBlock Text="Xóa toàn bộ nhật ký đã ghi trong phiên này" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Xóa" Style="{StaticResource FlatCardButtonStyle}"
                    VerticalAlignment="Center" Click="BtnClearLog_Click"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
