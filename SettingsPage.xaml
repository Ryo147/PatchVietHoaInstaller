<UserControl x:Class="VietHoaInstaller.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Arial">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,20,24,16">

            <TextBlock Text="Cài đặt phần mềm" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- ===== NHÓM: CẬP NHẬT ===== -->
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <TextBlock Text="CẬP NHẬT" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tự động kiểm tra cập nhật" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="Kiểm tra bản mới mỗi khi mở phần mềm" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkAutoUpdate" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Checked="ChkAutoUpdate_Changed" Unchecked="ChkAutoUpdate_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== NHÓM: KHAY HỆ THỐNG (TRAY) ===== -->
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <TextBlock Text="KHAY HỆ THỐNG" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Thu nhỏ xuống khay hệ thống khi đóng" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="Bấm nút X sẽ ẩn phần mềm xuống khay thay đóng phần mềm " Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkMinimizeToTray" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Checked="ChkMinimizeToTray_Changed" Unchecked="ChkMinimizeToTray_Changed"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,4"/>

                    <Grid Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tự động kiểm tra bản Patch Việt Hóa mới" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="Chạy ngầm và báo qua khay hệ thống khi có bản Patch mới" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkAutoCheckPatch" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Checked="ChkAutoCheckPatch_Changed" Unchecked="ChkAutoCheckPatch_Changed"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,4"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Thời gian kiểm tra (phút)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="Tối thiểu 15 phút để tránh bị GitHub giới hạn request" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#FF2C3244" CornerRadius="6" Height="24" Width="45" VerticalAlignment="Center">
                            <TextBox Grid.Column="1" x:Name="TxtPatchCheckInterval" Width="40" VerticalAlignment="Center"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" LostFocus="TxtPatchCheckInterval_LostFocus" Background="#FF2C3244" Text="15" Foreground="White" BorderThickness="0,0,0,0" Height="20"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== NHÓM: CÀI ĐẶT & GỠ VIỆT HÓA ===== -->
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <TextBlock Text="CÀI ĐẶT &amp; GỠ VIỆT HÓA" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Xác nhận trước khi Gỡ Việt hóa" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="Hiện thông báo hỏi lại trước khi gỡ" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkConfirmUninstall" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Checked="ChkConfirmUninstall_Changed" Unchecked="ChkConfirmUninstall_Changed"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,4"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tự động mở thư mục game sau khi cài xong" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="Mở File Explorer ngay khi cài đặt hoàn tất" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkAutoOpenFolder" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Checked="ChkAutoOpenFolder_Changed" Unchecked="ChkAutoOpenFolder_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== NHÓM: CỬA SỔ ỨNG DỤNG ===== -->
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <TextBlock Text="HIỂN THỊ PHẦN MỀM" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Luôn hiển thị phần mềm trên cùng" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="Giữ phần mềm luôn nổi trên các phần mềm khác" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkAlwaysOnTop" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Checked="ChkAlwaysOnTop_Changed" Unchecked="ChkAlwaysOnTop_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== NHÓM: DỮ LIỆU ===== -->
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <TextBlock Text="DỮ LIỆU" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Thư mục game đã ghi nhớ" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock x:Name="TxtRememberedFolder" Text="(chưa có)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Xóa" Style="{StaticResource FlatCardButtonStyle}" VerticalAlignment="Center" Click="BtnClearFolder_Click"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,4"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nhật ký hoạt động ở Trang chủ" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="Xóa toàn bộ nhật ký đã ghi trong phiên này" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Xóa" Style="{StaticResource FlatCardButtonStyle}" VerticalAlignment="Center" Click="BtnClearLog_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>