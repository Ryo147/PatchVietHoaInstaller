<UserControl x:Class="VietHoaInstaller.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Arial">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <!-- Banner phẳng, chữ đè lên trên -->
            <RowDefinition Height="*"/>
            <!-- Toàn bộ phần còn lại -->
        </Grid.RowDefinitions>

        <!-- ===== BANNER — dải hero toàn chiều rộng, không viền không bo góc, chữ đè trực tiếp lên ảnh ===== -->
        <Grid Grid.Row="0">
            <Border x:Name="BannerBorder">
                <Border.Background>
                    <ImageBrush x:Name="BannerImageBrush" ImageSource="/Assets/PlagueIncVH.jpg" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <!-- Lớp phủ tối dần từ dưới lên để chữ luôn đọc được dù ảnh sáng hay tối -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#001B1F2A" Offset="0"/>
                        <GradientStop Color="#CC1B1F2A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid Margin="20,0,20,14" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock x:Name="TxtSelectedGame" Text="—"
                               Foreground="White" FontSize="19" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" x:Name="StatusRow" RenderTransformOrigin="0,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="StatusBadgeScale" ScaleX="1" ScaleY="1"/>
                        </StackPanel.RenderTransform>
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource WarnBrush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="Chưa cài đặt Việt hóa"
                                   Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"
                                   FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtApplicableVersion" Text=""
               Foreground="{StaticResource TextMutedBrush}" FontSize="11"
               Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnChangeGame" Content="Đổi game" VerticalAlignment="Bottom"
                        Style="{StaticResource FlatCardButtonStyle}" Click="BtnChangeGame_Click"/>
            </Grid>
        </Grid>

        <!-- ===== PHẦN THÂN — chảy thẳng, phân tách bằng đường kẻ mảnh thay vì đóng khung ===== -->
        <Grid Grid.Row="1" Margin="20,18,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Label thư mục -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="34"/>
                <!-- Ô đường dẫn -->
                <RowDefinition Height="18"/>
                <RowDefinition Height="42"/>
                <!-- Nút hành động -->
                <RowDefinition Height="Auto"/>
                <!-- Tiến trình -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="1"/>
                <!-- Đường kẻ phân tách log -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <!-- Log -->
            </Grid.RowDefinitions>

            <TextBlock x:Name="LblFolderLabel" Grid.Row="0" Text="Thư mục game:"
                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="13.5"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtGamePath" Grid.Column="0" Style="{StaticResource PathTextBoxStyle}"
                         Text="Nhấp Chọn... để cài đặt thư mục cần cài đặt Việt hóa"
                         TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="White"/>
                <Button x:Name="BtnAutoDetect" Grid.Column="2" Content="Tự động tìm"
                        Style="{StaticResource BrowseButtonStyle}" Click="BtnAutoDetect_Click"/>
                <Button x:Name="BtnBrowse" Grid.Column="4" Content="Chọn..."
                        Style="{StaticResource BrowseButtonStyle}" Click="BtnBrowse_Click"/>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnInstall" Grid.Column="0" Content="CÀI ĐẶT PATCH"
                        Style="{StaticResource PrimaryButtonStyle}" Click="BtnInstall_Click"/>
                <Button x:Name="BtnUninstall" Grid.Column="2" Content="Gỡ Việt Hóa"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnUninstall_Click"
                        IsEnabled="False"/>
            </Grid>

            <StackPanel Grid.Row="5" x:Name="PanelProgress" Visibility="Collapsed" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Đang cài đặt:" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ProgressBar x:Name="ProgressInstall" Grid.Column="1" Style="{StaticResource InstallProgressBarStyle}"
                                 Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPercent" Grid.Column="2" Text="0%"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"
                               VerticalAlignment="Center" Margin="10,0,0,0" Width="36"/>
                </Grid>
                <TextBlock x:Name="TxtProgressDetail" Text=""
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border Grid.Row="7" Height="1" Background="{StaticResource DividerBrush}"/>

            <Grid Grid.Row="9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="NHẬT KÝ HOẠT ĐỘNG" Style="{StaticResource SectionHeaderStyle}"/>
                <ScrollViewer Grid.Row="2" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtLog" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" LineHeight="17"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
