<UserControl x:Class="VietHoaInstaller.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Arial">
    <Grid Margin="20,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <!-- Banner -->
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <!-- Tên game đang chọn -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <!-- Trạng thái -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <!-- Label thư mục -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="34"/>
            <!-- Ô đường dẫn -->
            <RowDefinition Height="22"/>
            <RowDefinition Height="42"/>
            <!-- Nút hành động -->
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <!-- Progress -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== BANNER / LOGO GAME ===== -->
        <Border Grid.Row="0" x:Name="BannerBorder" CornerRadius="1" BorderBrush="#3A3F4E" BorderThickness="1">
            <Border.Background>
                <ImageBrush x:Name="BannerImageBrush" ImageSource="/Assets/PlagueIncVH.jpg" Stretch="UniformToFill"/>
            </Border.Background>
        </Border>

        <!-- ===== GAME ĐANG CHỌN (chọn/đổi game qua trang Thư viện, không còn dropdown ở đây) ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="TxtSelectedGame" Text="—"
                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" x:Name="BtnChangeGame" Content="Đổi game"
                    Style="{StaticResource FlatCardButtonStyle}" Click="BtnChangeGame_Click"/>
        </Grid>

        <!-- ===== TRẠNG THÁI ===== -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Text="Trạng thái:" Foreground="{StaticResource TextMutedBrush}" FontSize="13.5" VerticalAlignment="Center"/>
            <Border x:Name="StatusBadge" Margin="10,0,0,0" CornerRadius="11" Padding="10,4"
                    Background="#332C3244" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="StatusBadgeScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource WarnBrush}"
                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="Chưa cài đặt Việt hóa"
                               Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"
                               FontSize="12.5" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== LABEL THƯ MỤC GAME ===== -->
        <TextBlock x:Name="LblFolderLabel" Grid.Row="6" Text="Thư mục game:"
                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="13.5" FontFamily="Arial"/>

        <!-- ===== Ô ĐƯỜNG DẪN + NÚT CHỌN ===== -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtGamePath" Grid.Column="0" Style="{StaticResource PathTextBoxStyle}"
                     Text="Nhấp Chọn... để cài đặt thư mục cần cài đặt Việt hóa"
                     TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="White"/>
            <Button x:Name="BtnAutoDetect" Grid.Column="2" Content="Tự động tìm"
                    Style="{StaticResource BrowseButtonStyle}" Click="BtnAutoDetect_Click"/>
            <Button x:Name="BtnBrowse" Grid.Column="4" Content="Chọn..."
                    Style="{StaticResource BrowseButtonStyle}" Click="BtnBrowse_Click"/>
        </Grid>

        <!-- ===== NÚT CÀI ĐẶT / GỠ ===== -->
        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnInstall" Grid.Column="0" Content="CÀI ĐẶT PATCH"
                    Style="{StaticResource PrimaryButtonStyle}" Click="BtnInstall_Click"/>
            <Button x:Name="BtnUninstall" Grid.Column="2" Content="Gỡ Việt Hóa"
                    Style="{StaticResource SecondaryButtonStyle}" Click="BtnUninstall_Click"
                    IsEnabled="False"/>
        </Grid>

        <!-- ===== TIẾN TRÌNH CÀI ĐẶT ===== -->
        <StackPanel Grid.Row="12" x:Name="PanelProgress" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Đang cài đặt:" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ProgressBar x:Name="ProgressInstall" Grid.Column="1" Style="{StaticResource InstallProgressBarStyle}"
                             Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtPercent" Grid.Column="2" Text="0%"
                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"
                           VerticalAlignment="Center" Margin="10,0,0,0" Width="36"/>
            </Grid>
            <TextBlock x:Name="TxtProgressDetail" Text=""
                       Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- ===== NHẬT KÝ HOẠT ĐỘNG ===== -->
        <Border Grid.Row="14" Margin="0,10,0,0" Background="#161A24" BorderBrush="#2C3244" BorderThickness="1" CornerRadius="2">
            <Grid Margin="10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Nhật ký hoạt động" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" FontWeight="SemiBold"/>
                <ScrollViewer Grid.Row="2" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtLog" Foreground="#FF8B90A3" FontSize="11"
                               FontFamily="Consolas" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
