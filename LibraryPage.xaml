<UserControl x:Class="VietHoaInstaller.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Arial">
    <Grid Margin="20,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Dự án Việt hóa"
                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtProjectCount" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,3,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GameList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*" MinWidth="60"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ảnh bìa -->
                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="7" Background="#2A2F42"
                                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                    <Rectangle RadiusX="6" RadiusY="6">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="{Binding BannerImagePath, Converter={StaticResource BannerConverter}}"
                                                        Stretch="UniformToFill"/>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Border>

                                <!-- Tên + trạng thái -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="13.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Nhãn Khả dụng / Sắp ra mắt -->
                                <Border Grid.Column="4" Background="{Binding BadgeBackground}" CornerRadius="5"
                                        Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}"
                                               FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>

                                <!-- Nút cài đặt -->
                                <Button Grid.Column="6" Content="Cài đặt" Style="{StaticResource FlatCardButtonStyle}"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                        IsEnabled="{Binding CanInstall}"
                                        Click="BtnInstallGame_Click" Tag="{Binding Profile}"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <!-- Nhẹ nhàng làm nổi bật thẻ khi rê chuột qua, giúp phân biệt rõ từng dòng -->
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
